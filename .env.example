# Azure OpenAI API Configuration
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=<your-api-key-here>
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4

# OpenRouter Configuration
# Set LLM_PROVIDER=openrouter to use these values.
OPENROUTER_API_KEY=<your-openrouter-api-key-here>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_HTTP_REFERER=http://localhost:3001
OPENROUTER_APP_NAME=SAS Accelerator
# Keep broad model routing by default. Use json_object/json_schema only with models
# that support structured outputs on OpenRouter.
OPENROUTER_RESPONSE_FORMAT=none
OPENROUTER_REQUIRE_PARAMETERS=false
OPENROUTER_RESPONSE_HEALING=false
LLM_MAX_TOKENS=12000

# Backend API Key (for authenticating API requests)
SAS_ACCELERATOR_API_KEY=<your-backend-api-key-here>

# Backend Configuration
SAS_ACCELERATOR_DEV_MODE=false
SAS_ACCELERATOR_CORS_ORIGINS=http://localhost:3001
GRAPH_BACKEND_PORT=5002
FLASK_DEBUG=false
